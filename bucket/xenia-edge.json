{
    "version": "20261127.1",
    "description": "Microsoft Xbox 360 emulator",
    "homepage": "https://github.com/has207/xenia-edge/",
    "license": {
        "identifier": "BSD-3-Clause",
        "url": "https://github.com/has207/xenia-edge/blob/edge/LICENSE"
    },
    "suggest": {
        "Microsoft Visual C++ Runtime 2022": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/has207/xenia-edge/releases/download/20261127.1/xenia_edge_20261127.1_windows.zip",
            "hash": "f96411711fb73bf780984aeddc4195eed65ce5fa97ae31685942c9e92a851f19"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "   New-Item \"$persist_dir\" -ItemType Directory | Out-Null",
        "   if (Test-Path \"$env:USERPROFILE\\Documents\\Xenia\") {",
        "       Write-Host \"Migrating AppData...\" -ForegroundColor yellow",
        "       Copy-Item -Path \"$env:USERPROFILE\\Documents\\Xenia\\*\" -Destination \"$persist_dir\" -Recurse",
        "       Remove-Item -Path \"$env:USERPROFILE\\Documents\\Xenia\" -Recurse",
        "   } else {",
        "       New-Item \"$dir\\xenia-edge.config.toml\" -ItemType File | Out-Null",
        "   }",
        "}"
    ],
    "post_install": "New-Item \"$dir\\portable.txt\" -ItemType File | Out-Null",
    "shortcuts": [
        [
            "xenia_edge.exe",
            "Microsoft Xbox 360 [x360][xenia] (edge)"
        ]
    ],
    "persist": [
        "cache",
        "cache_host",
        "config",
        "content",
        "library",
        "patches",
        "screenshots",
        "xenia-edge.config.toml"
    ],
    "checkver": {
        "github": "https://github.com/has207/xenia-edge"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/has207/xenia-edge/releases/download/$version/xenia_edge_$version_windows.zip"
            }
        }
    }
}
