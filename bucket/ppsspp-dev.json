        "}"
    ],
    "persist": [
        "memstick",
        "assets",
        "demos"
    ],
    "checkver": {
        "url": "https://builds.ppsspp.org/meta/history.json",
        "regex": "ppsspp_win_v(?<version>[\\d.]+)-(?<build>[\\d]+)-g(?<commit>[\\da-fA-F]+)\\.zip",
        "replace": "${version}-${build}-g${commit}"
    },
